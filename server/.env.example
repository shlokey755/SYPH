# Copy to server/.env (git-ignored) and fill in.

# Service account key: Firebase Console > Project settings > Service accounts > Generate new private key.
# It grants full access to your database - keep it secret. Paste the whole JSON on ONE line:
FIREBASE_SERVICE_ACCOUNT_JSON=
# ...or leave the line above empty and point to the downloaded file instead:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json

# Optional: Expo "enhanced push security" access token (expo.dev > Account settings > Access tokens)
EXPO_ACCESS_TOKEN=

# Optional: 1 = notifications read "New message" instead of showing the message text
PUSH_HIDE_PREVIEW=0

# Optional: port for GET /health (hosts such as Render and Railway expect the process to listen on one)
PORT=
