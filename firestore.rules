rules_version = '2';

// SYPH Firestore rules
//   users/{uid}                    public profile; any signed-in user may read (needed for search), only the owner writes
//   users/{uid}/private/settings   owner only (muted chats, push tokens)
//   userPush/{uid}                 owner writes, signed-in users get one (push targets for closed-app notifications)
//   usernames/{name}               claim registry: who owns each lower-case username
//   conversations/{id}             readable/writable only by members (participantIds)
//   conversations/{id}/messages    members only; senders cannot spoof senderId or backdate createdAt
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function convData(cid) {
      return get(/databases/$(database)/documents/conversations/$(cid)).data;
    }

    function isMemberOf(cid) {
      return signedIn() && request.auth.uid in convData(cid).participantIds;
    }

    // A member removing only themselves from a group.
    function isLeaving() {
      return request.resource.data.participantIds.toSet()
        == resource.data.participantIds.toSet().difference([request.auth.uid].toSet());
    }

    // ---------------- Users ----------------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------------- Conversations ----------------
    match /conversations/{cid} {

      // `get` on a missing document is allowed so clients can check "does this 1-on-1 chat exist yet?".
      allow get: if signedIn()
        && (resource == null || request.auth.uid in resource.data.participantIds);

      // Queries must filter on participantIds array-contains <your uid>.
      allow list: if signedIn() && request.auth.uid in resource.data.participantIds;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.participantIds
        && (
          request.resource.data.isGroup == true
          || (
            request.resource.data.participantIds.size() == 2
            && (
              cid == request.resource.data.participantIds[0] + '_' + request.resource.data.participantIds[1]
              || cid == request.resource.data.participantIds[1] + '_' + request.resource.data.participantIds[0]
            )
          )
        );

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.isGroup == resource.data.isGroup
        // Receipts: a member may only change their own delivered/read watermark.
        && request.resource.data.readState.diff(resource.data.readState).affectedKeys()
             .hasOnly([request.auth.uid])
        // A recorded group change must name the person making it and carry the server time (read by the push relay).
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['groupActivity'])
          || (
            request.resource.data.groupActivity.by == request.auth.uid
            && request.resource.data.groupActivity.at == request.time
          )
        )
        // The "group call in progress" pointer: groups only; set by a member, refreshed by participants, removed when
        // the call ends. It must name a member as the starter and carry nothing else.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeCall'])
          || (
            resource.data.isGroup == true
            && (
              !('activeCall' in request.resource.data)
              || (
                request.resource.data.activeCall.keys().hasOnly(['id', 'type', 'startedBy', 'startedByName', 'startedAt', 'beat'])
                && request.resource.data.activeCall.id is string
                && request.resource.data.activeCall.type in ['audio', 'video']
                && request.resource.data.activeCall.startedBy in resource.data.participantIds
                && request.resource.data.activeCall.startedByName is string
                && request.resource.data.activeCall.startedAt is number
                && request.resource.data.activeCall.beat is number
              )
            )
          )
        )
        // Membership: fixed for 1-on-1 chats; in groups only the creator edits it, or a member leaves.
        && (
          request.resource.data.participantIds == resource.data.participantIds
          || (
            resource.data.isGroup == true
            && (request.auth.uid == resource.data.createdBy || isLeaving())
          )
        );

      allow delete: if false;

      // ---------------- Messages ----------------
      match /messages/{mid} {
        allow read: if isMemberOf(cid);

        // Only text, GIFs and live locations can be sent. Stickers (just bigger emoji) were removed, and so were photos,
        // video, voice notes and documents (no file storage). Old messages of those kinds stay readable.
        // A live location message carries the time the share ends (epoch ms, at most 9 hours ahead: 8 h plus slack
        // for phone clocks that disagree). A one-time pin ("send current location") carries its own position instead,
        // with pin == true and expiresAt == 0.
        allow create: if isMemberOf(cid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'gif', 'location']
          && (
            request.resource.data.type != 'location'
            || (
              request.resource.data.location.keys().hasOnly(['expiresAt'])
              && request.resource.data.location.expiresAt is number
              && request.resource.data.location.expiresAt <= request.time.toMillis() + 32400000
            )
            || (
              request.resource.data.location.keys().hasOnly(['expiresAt', 'pin', 'lat', 'lng'])
              && request.resource.data.location.pin == true
              && request.resource.data.location.expiresAt == 0
              && request.resource.data.location.lat is number
              && request.resource.data.location.lat >= -90 && request.resource.data.location.lat <= 90
              && request.resource.data.location.lng is number
              && request.resource.data.location.lng >= -180 && request.resource.data.location.lng <= 180
            )
          )
          && request.resource.data.createdAt == request.time;

        allow update: if isMemberOf(cid) && (
          // Any member can hide a message for themselves ("delete for me").
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
            && request.resource.data.deletedFor.toSet()
                 .difference(resource.data.deletedFor.toSet()).hasOnly([request.auth.uid])
          )
          // Only the sender can delete for everyone, or end a live location (its end time can only move earlier).
          || (
            resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['deletedForEveryone', 'text', 'media', 'location'])
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['location'])
              || (
                resource.data.type == 'location'
                && (
                  // Deleting for everyone removes the field (and so a pin's position).
                  !('location' in request.resource.data)
                  // Ending a live share: only a live share can change, and only to an earlier end.
                  || (
                    resource.data.location.keys().hasOnly(['expiresAt'])
                    && request.resource.data.location.keys().hasOnly(['expiresAt'])
                    && request.resource.data.location.expiresAt <= resource.data.location.expiresAt
                  )
                )
              )
            )
          )
        );

        allow delete: if false;
      }

      // ---------------- Group calls ----------------
      // Audio and video go phone to phone. Firestore only carries who is in the call (peers) and the handshake
      // messages between two people (signals). Any member of the group may take part.
      match /groupCalls/{callId} {

        // Presence: one document per person in the call. Each person writes only their own; members read them all.
        match /peers/{uid} {
          allow read: if isMemberOf(cid);
          allow create, update: if isMemberOf(cid)
            && uid == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'sid', 'username', 'joinedAt', 'lastSeen', 'cameraOff', 'muted', 'expireAt'])
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.sid is string
            && request.resource.data.sid.size() > 0
            && request.resource.data.sid.size() <= 64
            && request.resource.data.username is string
            && request.resource.data.username.size() <= 60
            && request.resource.data.cameraOff is bool
            && request.resource.data.muted is bool
            && request.resource.data.lastSeen == request.time
            // The join time is the server's clock when the person joins, and never moves afterwards.
            && (request.resource.data.joinedAt == request.time || request.resource.data.joinedAt == resource.data.joinedAt);
          allow delete: if isMemberOf(cid) && uid == request.auth.uid;
        }

        // Handshake messages (offer, answer, ICE candidate) from one member to another. Only the addressee reads them
        // (queries filter on `to`); nobody edits or deletes them.
        match /signals/{signalId} {
          allow read: if isMemberOf(cid) && resource.data.to == request.auth.uid;
          allow create: if isMemberOf(cid)
            && request.resource.data.keys().hasOnly(['kind', 'from', 'fromSid', 'to', 'toSid', 'sdp', 'candidate', 'createdAt', 'expireAt'])
            && request.resource.data.from == request.auth.uid
            && request.resource.data.to in convData(cid).participantIds
            && request.resource.data.kind in ['offer', 'answer', 'candidate']
            && request.resource.data.fromSid is string
            && request.resource.data.toSid is string
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }

      // ---------------- Live locations ----------------
      // One document per live location share, named after its message. Members read it; only the sharer writes it,
      // and only the position and on/off switch can change after it is created.
      match /locations/{lid} {
        function validPosition(d) {
          return d.lat is number && d.lat >= -90 && d.lat <= 90
            && d.lng is number && d.lng >= -180 && d.lng <= 180
            && (d.accuracy == null || d.accuracy is number);
        }

        allow read: if isMemberOf(cid);
        allow create: if isMemberOf(cid)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(
               ['senderId', 'lat', 'lng', 'accuracy', 'active', 'updatedAt', 'expiresAt', 'expireAt'])
          && request.resource.data.active == true
          && validPosition(request.resource.data)
          && request.resource.data.expiresAt is number
          && request.resource.data.expiresAt <= request.time.toMillis() + 32400000;
        allow update: if isMemberOf(cid)
          && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['lat', 'lng', 'accuracy', 'active', 'updatedAt'])
          && validPosition(request.resource.data);
        allow delete: if false;
      }

      // ---------------- Typing indicator ----------------
      // One short-lived marker per member: "I am typing". Members read them; each member writes only their own,
      // so nobody can fake someone else typing. Markers are deleted when the person stops.
      match /typing/{uid} {
        allow read: if isMemberOf(cid);
        allow create, update: if isMemberOf(cid)
          && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['typing', 'at'])
          && request.resource.data.typing == true
          && request.resource.data.at == request.time;
        allow delete: if isMemberOf(cid) && uid == request.auth.uid;
      }
    }

    // ---------------- Push token registry ----------------
    // One entry per device token, naming the account currently signed in on that device. Whoever sends a push
    // (the sender's phone, or the optional relay) only uses a token whose entry names the recipient.
    // Clients can claim a token for themselves and delete their own entry. A signed-in user can read one entry by
    // exact token (that is how a sender checks the owner) but nobody can list the registry.
    match /pushTokens/{token} {
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'platform', 'updatedAt']);
      allow delete: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow get: if signedIn();
      allow list: if false;
    }

    // ---------------- Push mirror ----------------
    // The part of a user's private settings that a sender's phone needs to wake the recipient's phone: their device
    // tokens, the notifications switch and muted chats. Only the owner writes it; any signed-in user can read one
    // document by uid but nobody can list them. Without a server, this is what lets closed-app push work for free.
    match /userPush/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['tokens', 'notificationsEnabled', 'mutedChats', 'updatedAt'])
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() <= 5
        && request.resource.data.notificationsEnabled is bool
        && request.resource.data.mutedChats is list
        && request.resource.data.mutedChats.size() <= 200;
      allow delete: if isOwner(uid);
    }

    // ---------------- Username registry ----------------
    // One document per claimed username (lower-case id), naming its owner, so two accounts can never take the same
    // name even when they sign in with different emails. A signed-in user can claim a free name and release their own.
    match /usernames/{name} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9][a-z0-9._]{1,18}[a-z0-9]$')
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------------- Calls (1-to-1 signalling) ----------------
    // Only the two participants can see a call. Who may move it to which status is fixed below, and must match
    // allowedNextStatuses() in src/utils/call.ts.
    function validCallMove(before, after) {
      return (
        // The callee picks up or declines a ringing call.
        (request.auth.uid == before.calleeId && before.status == 'ringing' && after.status in ['accepted', 'declined'])
        // The caller gives up, or the ring times out.
        || (request.auth.uid == before.callerId && before.status == 'ringing' && after.status in ['cancelled', 'missed'])
        // Either side hangs up an answered call.
        || (before.status == 'accepted' && after.status == 'ended')
      );
    }

    match /calls/{callId} {
      allow get: if signedIn() && request.auth.uid in resource.data.participantIds;

      // Queries are checked against the fields they filter on. The incoming-call query filters on calleeId,
      // so the rule must be expressible in calleeId / callerId (participantIds alone would be rejected).
      allow list: if signedIn()
        && (resource.data.calleeId == request.auth.uid || resource.data.callerId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
             'conversationId', 'callerId', 'callerName', 'calleeId', 'calleeName',
             'participantIds', 'type', 'status', 'offer', 'createdAt', 'expireAt'
           ])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.participantIds.size() == 2
        && request.resource.data.participantIds.hasAll([request.resource.data.callerId, request.resource.data.calleeId])
        && request.resource.data.status == 'ringing'
        && request.resource.data.type in ['audio', 'video']
        && request.resource.data.offer.type == 'offer'
        && request.resource.data.createdAt == request.time
        // The two people must already share a 1-on-1 chat.
        && exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId))
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.isGroup == false
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data
             .participantIds.hasAll(request.resource.data.participantIds);

      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'answer', 'answeredAt', 'endedAt', 'endedBy'])
        && validCallMove(resource.data, request.resource.data)
        // Only the callee writes the answer, and only when picking up.
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['answer', 'answeredAt'])
          || (request.auth.uid == resource.data.calleeId && request.resource.data.status == 'accepted')
        );

      allow delete: if false;

      function callMembers() {
        return get(/databases/$(database)/documents/calls/$(callId)).data.participantIds;
      }

      match /candidates/{candidateId} {
        allow read: if signedIn() && request.auth.uid in callMembers();
        allow create: if signedIn()
          && request.auth.uid in callMembers()
          && request.resource.data.from == request.auth.uid;
        allow update, delete: if false;
      }

      // Each person's own media state (camera off, microphone muted). Members read; each member writes only their own.
      match /media/{uid} {
        allow read: if signedIn() && request.auth.uid in callMembers();
        allow create, update: if signedIn()
          && uid == request.auth.uid
          && request.auth.uid in callMembers()
          && request.resource.data.keys().hasOnly(['cameraOff', 'muted', 'expireAt'])
          && request.resource.data.cameraOff is bool
          && request.resource.data.muted is bool;
        allow delete: if false;
      }
    }

    // Everything else is closed.
    // ---------------- App config ----------------
    // appConfig/latest names the newest APK ({ latestVersion, apkUrl, notes }) for the Update button in the Me tab.
    // Signed-in users read it; nobody writes it from the app. The owner edits it by hand in the Firebase Console.
    match /appConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
