{
  "expo": {
    "name": "SYPH",
    "slug": "SYPH",
    "version": "7.5.5",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "syph",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syph.chat",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.syph.chat",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon5.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00E5FF",
          "defaultChannel": "messages"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SYPH uses your location only while you share it in a chat.",
          "locationWhenInUsePermission": "SYPH uses your location only while you share it in a chat."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow SYPH to use the camera for video calls.",
          "microphonePermission": "Allow SYPH to use the microphone for voice and video calls."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "@variant-systems/expo-dynamic-app-icon",
        {
          "cyber": { "image": "./assets/images/Cyber.png" },
          "monochrome": { "image": "./assets/images/Monochrome.png" },
          "candy": { "image": "./assets/images/Candy.png" },
          "ocean": { "image": "./assets/images/Ocean.png" },
          "forest": { "image": "./assets/images/Forest.png" },
          "sunset": { "image": "./assets/images/Sunset.png" }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7e0c1857-df34-4098-a4b2-5a4cd4d561de"
      }
    },
    "owner": "shlokey755"
  }
}